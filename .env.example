DB_HOST=<host_mysql_privado>
DB_PORT=3306
DB_USER=api_hta
DB_PASSWORD=<secreto_por_entorno>
DB_NAME=clinicas
DB_SSL_CA=/run/secrets/mysql-ca.pem
DB_POOL_MAX=10
DB_QUERY_TIMEOUT=60
MAX_CONCURRENT_SP=8
CACHE_TTL_SECONDS=600
API_KEYS_FILE=/run/secrets/api_keys.json
DOCS_ENABLED=false
ENVIRONMENT=production
CLOUDFLARE_TUNNEL_TOKEN=<token_por_entorno>
